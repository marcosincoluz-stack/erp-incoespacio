<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ocr_upload_wizard_form" model="ir.ui.view">
        <field name="name">incoluz.ocr.upload.wizard.form</field>
        <field name="model">incoluz.ocr.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Digitalizar facturas con IA">
                <sheet>
                    <group>
                        <field name="move_type"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="false">
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_mimetype" invisible="1"/>
                            <field name="file_size"/>
                        </tree>
                    </field>
                    <div class="text-muted mt8">
                        Añade líneas con el botón "Add a line" y sube en cada una un PDF o imagen (máx. 25 MB).
                    </div>
                </sheet>
                <footer>
                    <button name="action_process" type="object" string="Procesar con IA" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ocr_upload_wizard_action" model="ir.actions.act_window">
        <field name="name">Digitalizar facturas con IA</field>
        <field name="res_model">incoluz.ocr.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="ocr_upload_wizard_menu"
              name="Digitalizar facturas con IA"
              parent="account.menu_finance"
              action="ocr_upload_wizard_action"
              sequence="55"/>
</odoo>
