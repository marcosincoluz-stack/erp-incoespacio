<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ai_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>Digitalización OCR de Facturas con IA</h2>
                <div class="row mt16">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="gemini_api_key" string="Google Gemini API Key"/>
                            <div class="text-muted">Clave de API de Google Gemini (obtenida gratis en Google AI Studio).</div>
                            <field name="gemini_api_key" password="True" placeholder="AIzaSy..."/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="gemini_model" string="Modelo Gemini"/>
                            <div class="text-muted">Modelo de visión utilizado para procesar los documentos PDF e imágenes.</div>
                            <field name="gemini_model"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
