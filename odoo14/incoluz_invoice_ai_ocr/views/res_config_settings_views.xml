<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ai_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="inside">
                <h2>Digitalización OCR de Facturas con IA</h2>
                <div class="row mt16">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="gemini_api_key"/>
                            <span class="fa fa-lg fa-key" title="API Key" aria-label="API Key" role="img"/>
                            <div class="text-muted">
                                Clave de API de Google Gemini (obtenida gratis en Google AI Studio).
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="gemini_api_key" class="o_light_label" password="True" placeholder="AIzaSy..."/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="gemini_model"/>
                            <span class="fa fa-lg fa-cogs" title="Modelo" aria-label="Modelo" role="img"/>
                            <div class="text-muted">
                                Modelo de visión utilizado para procesar los documentos PDF e imágenes.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="gemini_model" class="o_light_label"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
