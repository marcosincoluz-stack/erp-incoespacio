<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla de registro: el técnico solo puede modificar tickets asignados a su persona -->
        <record id="ticket_manager_write_rule" model="ir.rule">
            <field name="name">Tickets: Técnico solo escribe asignados</field>
            <field name="model_id" ref="model_incoespacio_support_ticket"/>
            <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('incoespacio_security.support_group_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla de registro: el Administrador puede modificar cualquier ticket -->
        <record id="ticket_admin_write_rule" model="ir.rule">
            <field name="name">Tickets: Administrador escribe todos</field>
            <field name="model_id" ref="model_incoespacio_support_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('incoespacio_security.support_group_admin'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
