<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- VISTA FORMULARIO -->
        <record id="ticket_view_form" model="ir.ui.view">
            <field name="name">incoespacio_support.ticket.form</field>
            <field name="model">incoespacio_support.ticket</field>
            <field name="arch" type="xml">
                <form string="Ticket de Soporte">
                    <header>
                        <button string="Iniciar revisión" name="button_working" type="object" class="btn-primary" invisible="state != 'draft'" groups="incoespacio_security.support_group_admin,incoespacio_security.support_group_manager" />
                        <button string="Marcar como resuelto" name="button_soon" type="object" class="btn-primary" invisible="state != 'working'" groups="incoespacio_security.support_group_admin,incoespacio_security.support_group_manager" />
                        <button string="Cerrar ticket" name="button_done" type="object" class="btn-primary" invisible="state != 'soon'" groups="incoespacio_security.support_group_admin,incoespacio_security.support_group_manager" />
                        <button string="Reiniciar a borrador" name="button_reset" type="object" class="btn-secondary" invisible="state == 'draft'" groups="incoespacio_security.support_group_admin" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,working,soon,done" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="title" string="Asunto del Ticket"/>
                            <h1>
                                <field name="title" placeholder="Describe brevemente la incidencia..."/>
                            </h1>
                            <div class="d-flex align-items-center gap-3 my-2">
                                <field name="priority" widget="priority"/>
                                <field name="pinned" widget="boolean_toggle" string="Fijado"/>
                                <span class="badge text-bg-light fs-6">
                                    <field name="name" readonly="1"/>
                                </span>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="type_id" options="{'no_open': True, 'no_create': True}"/>
                                <field name="category_id" placeholder="Área afectada" options="{'no_open': True, 'no_create': True}"/>
                            </group>
                            <group>
                                <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <field name="create_date" readonly="1" string="Fecha de creación"/>
                                <field name="closed_date" invisible="not closed_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="description" string="Descripción detallada">
                                <field name="description" placeholder="Explica detalladamente qué sucede o qué se necesita..."/>
                            </page>
                            <page name="error_log" string="Registro de error (Log)">
                                <div class="alert alert-danger mb-2" role="alert">
                                    Pega aquí el código o traza de error que haya mostrado la pantalla:
                                </div>
                                <field name="error_log" placeholder="Copia y pega el mensaje de error o traza técnica aquí..."/>
                            </page>
                            <page name="resolution" string="Resolución">
                                <field name="resolution" placeholder="Explica la solución aplicada antes de cerrar el ticket..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- VISTA LISTA (TREE) -->
        <record id="ticket_view_tree" model="ir.ui.view">
            <field name="name">incoespacio_support.ticket.tree</field>
            <field name="model">incoespacio_support.ticket</field>
            <field name="arch" type="xml">
                <tree string="Tickets de Soporte" default_order="pinned desc, id desc" sample="1" decoration-muted="state in ('done','soon')" decoration-primary="state == 'working'">
                    <field name="priority" widget="priority" optional="show"/>
                    <field name="name" string="Ref." decoration-bf="1"/>
                    <field name="title"/>
                    <field name="type_id" widget="badge" optional="show"/>
                    <field name="category_id" optional="show"/>
                    <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                    <field name="assigned_user_id" widget="many2one_avatar_user" optional="show"/>
                    <field name="create_date" string="Creado el" optional="show"/>
                    <field name="closed_date" string="Cerrado el" optional="hide"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-info="state == 'working'" decoration-success="state == 'soon'" decoration-muted="state == 'done'"/>
                </tree>
            </field>
        </record>

        <!-- VISTA KANBAN -->
        <record id="ticket_view_kanban" model="ir.ui.view">
            <field name="name">incoespacio_support.ticket.kanban</field>
            <field name="model">incoespacio_support.ticket</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" sample="1" quick_create="false">
                    <field name="state"/>
                    <field name="name"/>
                    <field name="title"/>
                    <field name="type_id"/>
                    <field name="priority"/>
                    <field name="assigned_user_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click p-3 rounded shadow-sm bg-white mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge text-bg-secondary"><field name="name"/></span>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="fw-bold mb-2 text-dark"><field name="title"/></div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="badge text-bg-light border"><field name="type_id"/></span>
                                    <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- VISTA BÚSQUEDA Y FILTROS -->
        <record id="ticket_view_search" model="ir.ui.view">
            <field name="name">incoespacio_support.ticket.search</field>
            <field name="model">incoespacio_support.ticket</field>
            <field name="arch" type="xml">
                <search string="Buscar Tickets">
                    <field name="name" string="Referencia"/>
                    <field name="title" string="Asunto"/>
                    <field name="user_id" string="Creador"/>
                    <field name="assigned_user_id" string="Técnico asignado"/>
                    <filter string="Mis tickets asignados" name="my_assigned" domain="[('assigned_user_id', '=', uid)]"/>
                    <filter string="Creados por mí" name="my_created" domain="[('user_id', '=', uid)]"/>
                    <separator/>
                    <filter string="Abiertos / Pendientes" name="open_tickets" domain="[('state', 'in', ['draft', 'working'])]"/>
                    <filter string="Resueltos / Cerrados" name="closed_tickets" domain="[('state', 'in', ['soon', 'done'])]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Técnico asignado" name="group_assigned" context="{'group_by': 'assigned_user_id'}"/>
                        <filter string="Tipo de ticket" name="group_type" context="{'group_by': 'type_id'}"/>
                        <filter string="Área" name="group_category" context="{'group_by': 'category_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACCIONES -->
        <record id="ticket_action" model="ir.actions.act_window">
            <field name="name">Tickets de Soporte</field>
            <field name="res_model">incoespacio_support.ticket</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="ticket_view_search"/>
            <field name="context">{'search_default_open_tickets': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primer ticket de soporte o incidencia!
                </p>
                <p>
                    Gestiona y resuelve cualquier petición de clientes o problemas internos de forma ordenada.
                </p>
            </field>
        </record>

        <!-- MENÚS PRINCIPALES -->
        <menuitem id="support_menu_root" name="Soporte" sequence="40" web_icon="incoespacio_support,static/description/icon.png"/>
        <menuitem id="ticket_menu" name="Tickets" parent="support_menu_root" sequence="1" action="ticket_action"/>
        <menuitem id="support_menu_conf" name="Configuración" parent="support_menu_root" sequence="2" groups="incoespacio_security.support_group_admin"/>

    </data>
</odoo>
