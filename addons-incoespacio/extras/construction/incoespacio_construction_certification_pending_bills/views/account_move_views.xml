<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_pending_bills" model="ir.ui.view">
        <field name="name">account.move.form.inherit.pending.bills</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="incoespacio_construction_certification.view_move_form_inherit_construction"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="certification_id" readonly="1"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_pending_bills" model="ir.ui.view">
        <field name="name">account.move.search.inherit.pending.bills</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Sin certificar" name="sin_certificar"
                        domain="[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('project_id', '!=', False), ('certification_id', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
