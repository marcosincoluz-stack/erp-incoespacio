<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_construction_cost_split" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construction.cost.split</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="incoespacio_construction_cost.view_move_form_inherit_construction_cost"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='construction_line_id']" position="after">
                <button name="action_split_partida" type="object" icon="fa-scissors"
                        title="Repartir entre partidas"
                        column_invisible="parent.state != 'draft' or parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_construction_cost_assign" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construction.cost.assign</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="incoespacio_construction_certification.view_move_form_inherit_construction"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='construction_obra_actions']" position="inside">
                <field name="has_unassigned_partida" invisible="1"/>
                <button name="action_assign_partida" type="object" string="Imputar a partidas"
                        class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('in_invoice', 'in_refund') or not project_id or not has_unassigned_partida"/>
            </xpath>
        </field>
    </record>
</odoo>
