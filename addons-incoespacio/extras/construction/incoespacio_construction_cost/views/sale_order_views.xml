<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_inherit_construction_cost" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.construction.cost</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="incoespacio_construction_certification.view_order_form_inherit_certification" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_job_margin']" position="after">
                <field name="amount_cost_in_chapter" widget="monetary" />
                <field name="amount_cost_no_chapter" widget="monetary" decoration-danger="amount_cost_no_chapter > 0" />
                <field name="chapter_cost_text" widget="text" placeholder="Sin gasto imputado a capítulos" />
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                <field name="amount_vendor_cost" optional="show" widget="monetary" />
            </xpath>
        </field>
    </record>
</odoo>
