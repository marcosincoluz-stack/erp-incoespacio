<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_construction_cost" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construction.cost</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="after">
                <field name="construction_section_id"
                       string="Capítulo"
                       optional="show"
                       context="{'short_construction_line': True}"
                       options="{'no_create': True, 'no_quick_create': True}"
                       domain="[('display_type', '=', 'line_section'), ('order_id.project_id', '=', parent.project_id)]"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="construction_line_id"
                       string="Partida"
                       optional="show"
                       context="{'short_construction_line': True}"
                       options="{'no_create': True, 'no_quick_create': True}"
                       domain="[('display_type', '=', False), ('order_id.project_id', '=', parent.project_id), ('bc3_section_id', '=?', construction_section_id)]"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_construction_cost" model="ir.ui.view">
        <field name="name">account.move.search.inherit.construction.cost</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Gastos sin obra" name="gastos_sin_obra"
                        domain="[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('project_id', '=', False), ('construction_not_job', '=', False)]"/>
                <filter string="Gastos sin partida" name="gastos_sin_partida"
                        domain="[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('project_id', '!=', False), ('has_unassigned_partida', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="action_gastos_sin_partida" model="ir.actions.act_window">
        <field name="name">Gastos sin partida</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('project_id', '!=', False), ('has_unassigned_partida', '=', True)]</field>
        <field name="context">{'search_default_gastos_sin_partida': 1}</field>
    </record>
</odoo>
