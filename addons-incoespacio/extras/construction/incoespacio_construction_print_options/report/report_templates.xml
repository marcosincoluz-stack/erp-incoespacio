<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="chapter_summary">
        <t t-set="cell_pad" t-value="'2px 4px' if summary_compact else '4px 6px'" />
        <div
      t-if="chapters"
      class="inco-card"
      t-att-style="'page-break-inside: avoid; margin-top: %s;%s%s' % ('0' if summary_break else '16px', ' page-break-before: always;' if summary_break else '', ' padding: 6px 8px;' if summary_compact else '')"
    >
            <div
        class="inco-card-title"
        t-out="summary_title"
        t-att-style="'font-size: 9.5px; letter-spacing: 0; margin-bottom: 3px; padding-bottom: 2px;' if summary_compact else ''"
      />
            <table
        t-att-style="'width: 100%; border-collapse: separate; border-spacing: 0; font-size: ' + ('9.5px' if summary_compact else '0.82rem')"
      >
                <thead>
                    <tr>
                        <th
              t-attf-style="text-align: left; width: 18%; padding: {{ cell_pad }}; border-bottom: 1px solid #cbd5e1;"
            >Código</th>
                        <th
              t-attf-style="text-align: left; padding: {{ cell_pad }}; border-bottom: 1px solid #cbd5e1;"
            >Capítulo</th>
                        <th
              t-attf-style="text-align: right; width: 22%; padding: {{ cell_pad }}; border-bottom: 1px solid #cbd5e1;"
            >Importe</th>
                        <th
              t-if="show_chapter_pct"
              t-attf-style="text-align: right; width: 12%; padding: {{ cell_pad }}; border-bottom: 1px solid #cbd5e1;"
            >%</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="chapters" t-as="chapter">
                        <td t-attf-style="padding: {{ cell_pad }};"><span
                t-out="chapter['decimal'] if show_decimal_code else chapter['code']"
              /></td>
                        <td t-attf-style="padding: {{ cell_pad }};"><span t-out="chapter['name']" /></td>
                        <td t-attf-style="padding: {{ cell_pad }}; text-align: right;">
                            <span
                t-out="chapter['amount']"
                t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
              />
                        </td>
                        <td t-if="show_chapter_pct" t-attf-style="padding: {{ cell_pad }}; text-align: right;"><span
                t-out="'%.1f' % chapter['pct']"
              /> %</td>
                    </tr>
                    <tr style="font-weight: 700;">
                        <td colspan="2" t-attf-style="padding: {{ cell_pad }}; border-top: 1px solid #94a3b8;"><span
                t-out="summary_total_label"
              /></td>
                        <td t-attf-style="padding: {{ cell_pad }}; text-align: right; border-top: 1px solid #94a3b8;">
                            <span t-if="summary_order_total" t-field="doc.amount_untaxed" />
                            <span
                t-else=""
                t-out="sum(chapter['amount'] for chapter in chapters)"
                t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
              />
                        </td>
                        <td
              t-if="show_chapter_pct"
              t-attf-style="padding: {{ cell_pad }}; text-align: right; border-top: 1px solid #94a3b8;"
            >100 %</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="report_saleorder_print_options" inherit_id="sale.report_saleorder_document" priority="30">
        <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
            <attribute
        name="t-value"
      >doc._get_custom_report_lines() if custom else doc._get_order_lines_to_report()</attribute>
        </xpath>
        <xpath expr="//table[hasclass('o_main_table')]" position="after">
            <t
        t-set="chapters"
        t-value="doc._get_chapter_summary(lines_to_report) if custom else doc._get_chapter_summary()"
      />
            <t t-set="summary_order_total" t-value="not custom" />
            <t t-set="show_chapter_pct" t-value="True" />
            <t t-set="show_decimal_code" t-value="doc.bc3" />
            <t t-set="summary_title" t-value="'Resumen de presupuesto'" />
            <t t-set="summary_total_label" t-value="'TOTAL EJECUCIÓN MATERIAL'" />
            <t t-set="summary_compact" t-value="False" />
            <t t-set="summary_break" t-value="False" />
            <t t-call="incoespacio_construction_print_options.chapter_summary" />
        </xpath>
        <xpath expr="//td[@name='td_name']/span" position="replace">
            <span t-if="doc.bc3" t-out="line._print_decimal_name()" />
            <span t-else="" t-field="line.name" />
        </xpath>
        <xpath expr="//td[@name='td_section_line']/span" position="replace">
            <span t-if="doc.bc3" t-out="line._print_decimal_name()" />
            <span t-else="" t-field="line.name" />
        </xpath>
    </template>

    <template
    id="report_certification_print_options"
    inherit_id="incoespacio_construction_certification.report_certification_document"
  >
        <xpath expr="//t[@t-foreach='o._get_report_lines()']" position="attributes">
            <attribute name="t-foreach">o._get_custom_report_lines() if custom else o._get_report_lines()</attribute>
        </xpath>
        <xpath expr="//table[hasclass('table-bordered')][1]" position="after">
            <t t-if="not custom">
                <t t-set="doc" t-value="o" />
                <t t-set="chapters" t-value="o._get_chapter_summary()" />
                <t t-set="summary_order_total" t-value="False" />
                <t t-set="show_chapter_pct" t-value="True" />
                <t t-set="show_decimal_code" t-value="True" />
                <t t-set="summary_title" t-value="'Resumen de capítulos'" />
                <t t-set="summary_total_label" t-value="'TOTAL PERIODO'" />
                <t t-set="summary_compact" t-value="True" />
                <t t-set="summary_break" t-value="True" />
                <t t-call="incoespacio_construction_print_options.chapter_summary" />
            </t>
        </xpath>
        <xpath expr="//table[hasclass('inco-cert-totals')]" position="after">
            <p t-if="not custom" style="clear: both; margin-top: 12px; font-size: 0.82rem;">
                Asciende la presente certificación a la expresada cantidad de
                <strong t-out="o._cert_amount_words()" />.
            </p>
        </xpath>
        <xpath expr="//t[@t-else='']/tr" position="after">
            <t t-if="custom and o.print_measures">
                <t t-set="measure_groups" t-value="l._print_measure_groups()" />
                <tr t-if="measure_groups">
                    <td style="border-left: none; border-right: none;" />
                    <td colspan="10" style="padding: 2px 6px 8px 8px; border-left: none; border-right: none;">
                        <table style="width: 100%; border-collapse: separate; border-spacing: 0; font-size: 9px;">
                            <thead>
                                <tr style="color: #64748b;">
                                    <th
                    style="text-align: left; font-weight: 600; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Comentario</th>
                                    <th
                    style="text-align: right; font-weight: 600; width: 10%; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Uds</th>
                                    <th
                    style="text-align: right; font-weight: 600; width: 10%; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Largo</th>
                                    <th
                    style="text-align: right; font-weight: 600; width: 10%; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Ancho</th>
                                    <th
                    style="text-align: right; font-weight: 600; width: 10%; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Alto</th>
                                    <th
                    style="text-align: right; font-weight: 600; width: 12%; padding: 2px 4px; border-bottom: 1px solid #e2e8f0;"
                  >Parcial</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="measure_groups" t-as="group">
                                    <tr>
                                        <td
                      colspan="6"
                      t-attf-style="padding: 4px 4px 2px; font-weight: 700; border-bottom: 1px solid #e2e8f0; background-color: {{ '#eef2ff' if group['current'] else '#f8fafc' }};"
                    >
                                            Certificación <t t-out="group['cert']" /><t
                        t-if="group['current']"
                      > · este periodo</t>
                                        </td>
                                    </tr>
                                    <tr t-foreach="group['rows']" t-as="row">
                                        <td style="padding: 1px 4px;"><span t-esc="row.get('comment')" /></td>
                                        <td style="padding: 1px 4px; text-align: right;"><span
                        t-if="row.get('units')"
                        t-esc="formatLang(row.get('units'), digits=3)"
                      /></td>
                                        <td style="padding: 1px 4px; text-align: right;"><span
                        t-if="row.get('length')"
                        t-esc="formatLang(row.get('length'), digits=3)"
                      /></td>
                                        <td style="padding: 1px 4px; text-align: right;"><span
                        t-if="row.get('width')"
                        t-esc="formatLang(row.get('width'), digits=3)"
                      /></td>
                                        <td style="padding: 1px 4px; text-align: right;"><span
                        t-if="row.get('height')"
                        t-esc="formatLang(row.get('height'), digits=3)"
                      /></td>
                                        <td style="padding: 1px 4px; text-align: right;"><span
                        t-esc="formatLang(row.get('partial') or 0, digits=3)"
                      /></td>
                                    </tr>
                                    <tr>
                                        <td
                      colspan="5"
                      style="padding: 2px 4px 6px; text-align: right; color: #475569;"
                    >Total certificación <t t-out="group['cert']" /></td>
                                        <td
                      style="padding: 2px 4px 6px; text-align: right; font-weight: 700; border-top: 1px solid #cbd5e1;"
                    ><span t-esc="formatLang(group['total'], digits=3)" /></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </td>
                </tr>
            </t>
        </xpath>
        <xpath expr="//t[@t-else='']//span[@t-esc='l._get_report_name()']" position="after">
            <div
        t-if="custom and o.print_full_text and l.bc3_text"
        t-out="(l.bc3_text or '').strip().removesuffix('|').strip()"
        style="white-space: pre-line; font-size: 8px; color: #475569;"
      />
        </xpath>
    </template>
</odoo>
