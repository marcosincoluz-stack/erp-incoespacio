<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_saleorder_custom" model="ir.actions.report">
        <field name="name">Presupuesto personalizado</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">incoespacio_construction_print_layout.report_saleorder_custom</field>
        <field name="report_file">incoespacio_construction_print_layout.report_saleorder_custom</field>
        <field name="paperformat_id" ref="incoespacio_reports.paperformat_incoespacio"/>
    </record>

    <template id="budget_colgroup">
        <colgroup>
            <col t-if="doc.print_show_code" t-attf-style="width: #{'9%' if doc.print_measures else '10%'}"/>
            <col t-attf-style="width: #{'5%' if doc.print_measures else '6%'}"/>
            <col/>
            <col t-if="doc.print_measures" style="width: 6%"/>
            <col t-if="doc.print_measures" style="width: 7%"/>
            <col t-if="doc.print_measures" style="width: 7%"/>
            <col t-if="doc.print_measures" style="width: 7%"/>
            <col t-if="doc.print_measures" style="width: 8%"/>
            <col t-attf-style="width: #{'9%' if doc.print_measures else '11%'}"/>
            <col t-if="doc.print_prices" t-attf-style="width: #{'9%' if doc.print_measures else '11%'}"/>
            <col t-if="doc.print_prices" t-attf-style="width: #{'11%' if doc.print_measures else '13%'}"/>
        </colgroup>
    </template>

    <template id="budget_head">
        <thead>
            <tr>
                <th t-if="doc.print_show_code" class="desc code">Código</th>
                <th class="desc">Ud</th>
                <th class="desc">Resumen</th>
                <th t-if="doc.print_measures" class="num">Uds</th>
                <th t-if="doc.print_measures" class="num">Largo</th>
                <th t-if="doc.print_measures" class="num">Ancho</th>
                <th t-if="doc.print_measures" class="num">Alto</th>
                <th t-if="doc.print_measures" class="num">Parcial</th>
                <th class="num">Cantidad</th>
                <th t-if="doc.print_prices" class="num">Precio</th>
                <th t-if="doc.print_prices" class="num">Importe</th>
            </tr>
        </thead>
    </template>

    <template id="budget_chapter_rows">
        <t t-set="chapter_amount" t-value="sum(line.price_subtotal for line in block['lines'] if not line.display_type)"/>
        <t t-set="chapter_label" t-value="block['chapter']._print_label() if block['chapter'] else ('', '')"/>
        <tr t-if="block['chapter']" class="inco-chapter">
            <td t-if="doc.print_show_code" class="code"><span t-out="chapter_label[0]"/></td>
            <td/>
            <td class="name"><span t-out="chapter_label[1]"/></td>
            <td t-if="doc.print_measures" colspan="5"/>
            <td/>
            <td t-if="doc.print_prices"/>
            <td t-if="doc.print_prices"/>
        </tr>
        <t t-foreach="block['lines']" t-as="line">
            <tr t-if="line.display_type == 'line_section'" class="inco-subchapter">
                <t t-set="label" t-value="line._print_label()"/>
                <td t-if="doc.print_show_code" class="code"><span t-out="label[0]"/></td>
                <td/>
                <td class="name" t-attf-style="padding-left: #{8 + (line.bc3_level or 0) * 8}px;"><span t-out="label[1]"/></td>
                <td t-if="doc.print_measures" colspan="5"/>
                <td/>
                <td t-if="doc.print_prices"/>
                <td t-if="doc.print_prices"/>
            </tr>
            <tr t-elif="line.display_type == 'line_note'">
                <td t-if="doc.print_show_code"/>
                <td/>
                <td class="name" t-out="line.name"/>
                <td t-if="doc.print_measures" colspan="5"/>
                <td/>
                <td t-if="doc.print_prices"/>
                <td t-if="doc.print_prices"/>
            </tr>
            <t t-else="">
                <t t-set="label" t-value="line._print_label()"/>
                <t t-set="measures" t-value="line._report_measure_rows() if doc.print_measures else []"/>
                <tr class="inco-partida">
                    <td t-if="doc.print_show_code" class="code"><span t-out="label[0]"/></td>
                    <td class="ud"><span t-out="line._print_uom()"/></td>
                    <td class="name">
                        <div t-out="label[1]"/>
                        <div t-if="doc.print_full_text and line._print_bc3_text()" class="inco-text" t-out="line._print_bc3_text()"/>
                    </td>
                    <td t-if="doc.print_measures" colspan="5"/>
                    <td class="num"/>
                    <td t-if="doc.print_prices" class="num"/>
                    <td t-if="doc.print_prices" class="num"/>
                </tr>
                <tr t-foreach="measures" t-as="row" class="inco-measure">
                    <td t-if="doc.print_show_code"/>
                    <td/>
                    <td class="name"><span t-out="row.get('comment')"/></td>
                    <td t-foreach="('units', 'length', 'width', 'height', 'partial')" t-as="key" class="num">
                        <span t-if="row.get(key)" t-out="row.get(key)" t-options='{"widget": "float", "precision": 3}'/>
                    </td>
                    <td class="num"/>
                    <td t-if="doc.print_prices" class="num"/>
                    <td t-if="doc.print_prices" class="num"/>
                </tr>
                <tr t-att-class="'inco-measure-total' if measures else 'inco-amount'">
                    <td t-if="doc.print_show_code"/>
                    <td/>
                    <td/>
                    <td t-if="doc.print_measures" colspan="5"/>
                    <td class="num">
                        <span t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 3}'/>
                    </td>
                    <td t-if="doc.print_prices" class="num">
                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                    <td t-if="doc.print_prices" class="num">
                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
            </t>
        </t>
        <tr t-if="doc.print_subtotals and doc.print_prices and block['chapter']" class="inco-chapter-total">
            <td t-if="doc.print_show_code"/>
            <td/>
            <td class="name total-label">
                Total <t t-if="chapter_label[0]"><span t-out="chapter_label[0]"/> </t><span t-out="chapter_label[1]"/>
            </td>
            <td t-if="doc.print_measures" colspan="5"/>
            <td/>
            <td t-if="doc.print_prices"/>
            <td t-if="doc.print_prices" class="num">
                <span t-out="chapter_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
            </td>
        </tr>
    </template>

    <template id="report_saleorder_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <t t-set="report_title" t-value="doc._print_title()"/>
                <t t-set="chapters" t-value="doc._get_chapter_summary(doc._get_custom_report_lines())"/>
                <t t-call="incoespacio_reports.external_layout_incoespacio" t-lang="doc.partner_id.lang">
                    <div class="page">
                        <div t-if="doc.print_cover" class="inco-cover">
                            <div class="inco-cover-title" t-out="report_title"/>
                            <div class="inco-cover-ref">Nº <span t-field="doc.name"/></div>
                            <table class="inco-cover-meta">
                                <tr t-if="doc.project_id">
                                    <td>Obra</td>
                                    <td><span t-field="doc.project_id.name"/></td>
                                </tr>
                                <tr>
                                    <td>Cliente</td>
                                    <td><span t-field="doc.partner_id.name"/></td>
                                </tr>
                                <tr t-if="doc.client_order_ref">
                                    <td>Referencia</td>
                                    <td><span t-field="doc.client_order_ref"/></td>
                                </tr>
                                <tr t-if="doc.date_order">
                                    <td>Fecha</td>
                                    <td><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                </tr>
                            </table>
                        </div>

                        <t t-call="incoespacio_reports.sale_address_cards"/>

                        <t t-set="blocks" t-value="doc._get_print_blocks()"/>
                        <t t-set="budget_cols" t-value="(1 if doc.print_show_code else 0) + (5 if doc.print_measures else 0) + (2 if doc.print_prices else 0) + 3"/>
                        <t t-if="not doc.print_only_chapters and doc.print_page_break">
                            <t t-foreach="blocks" t-as="block">
                                <table class="inco-budget-table" t-att-style="block_index and 'page-break-before: always;'">
                                    <t t-call="incoespacio_construction_print_layout.budget_colgroup"/>
                                    <t t-call="incoespacio_construction_print_layout.budget_head"/>
                                    <tbody>
                                        <t t-call="incoespacio_construction_print_layout.budget_chapter_rows"/>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                        <table t-elif="not doc.print_only_chapters" class="inco-budget-table">
                            <t t-call="incoespacio_construction_print_layout.budget_colgroup"/>
                            <t t-call="incoespacio_construction_print_layout.budget_head"/>
                            <t t-foreach="blocks" t-as="block">
                                <tbody>
                                    <tr t-if="block_index" class="inco-chapter-gap">
                                        <td t-att-colspan="budget_cols"/>
                                    </tr>
                                    <t t-call="incoespacio_construction_print_layout.budget_chapter_rows"/>
                                </tbody>
                            </t>
                        </table>

                        <t t-if="doc.print_summary and doc.print_prices">
                            <t t-set="summary_order_total" t-value="False"/>
                            <t t-set="show_chapter_pct" t-value="doc.print_summary_pct"/>
                            <t t-set="show_decimal_code" t-value="doc.print_code != 'project'"/>
                            <t t-set="summary_title" t-value="'Resumen de presupuesto'"/>
                            <t t-set="summary_total_label" t-value="'TOTAL EJECUCIÓN MATERIAL'"/>
                            <t t-set="summary_compact" t-value="False"/>
                            <t t-set="summary_break" t-value="False"/>
                            <t t-call="incoespacio_construction_print_options.chapter_summary"/>
                        </t>

                        <div t-if="doc.print_prices and doc.print_gg_bi" class="clearfix" style="margin-top: 16px;">
                            <t t-set="totals" t-value="doc._get_print_totals(chapters)"/>
                            <table class="incoespacio-totals-table">
                                <tr>
                                    <td>Ejecución material</td>
                                    <td class="text-end"><span t-out="totals['material']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Gastos generales (<span t-out="'%.2f' % doc.print_gg_pct"/> %)</td>
                                    <td class="text-end"><span t-out="totals['gg']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Beneficio industrial (<span t-out="'%.2f' % doc.print_bi_pct"/> %)</td>
                                    <td class="text-end"><span t-out="totals['bi']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>Ejecución por contrata</td>
                                    <td class="text-end"><span t-out="totals['contract']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td>IVA (<span t-out="'%.0f' % totals['rate']"/> %)</td>
                                    <td class="text-end"><span t-out="totals['tax']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr class="o_total">
                                    <td>Total</td>
                                    <td class="text-end"><span t-out="totals['total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                            </table>
                        </div>
                        <div t-elif="doc.print_prices and not doc.print_chapter_first_id and not doc.print_chapter_last_id" class="clearfix" style="margin-top: 16px;">
                            <table class="incoespacio-totals-table">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-call="sale.document_tax_totals"/>
                            </table>
                        </div>

                        <p t-if="doc.print_amount_words and doc.print_prices" class="inco-amount-words">
                            Asciende el presupuesto a la expresada cantidad de
                            <strong t-out="doc._print_words_amount(chapters)"/>.
                        </p>

                        <t t-if="doc.print_signature" t-call="incoespacio_reports.sale_conditions_signature"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
