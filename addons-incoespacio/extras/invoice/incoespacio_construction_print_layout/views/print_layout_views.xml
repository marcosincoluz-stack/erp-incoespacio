<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_print_custom_layout" model="ir.ui.view">
        <field name="name">sale.order.print.custom.layout</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="incoespacio_construction_print_options.view_sale_order_print_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_chapters']" position="before">
                <group string="Contenido">
                    <field name="print_full_text"/>
                    <field name="print_measures"/>
                    <field name="print_prices"/>
                    <field name="print_show_code"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='print_hide_null_chapters']" position="after">
                <field name="print_subtotals"/>
                <field name="print_page_break"/>
                <field name="print_only_chapters"/>
            </xpath>
            <xpath expr="//group[@name='group_partidas']" position="after">
                <group string="Resumen y totales">
                    <field name="print_summary"/>
                    <field name="print_gg_bi"/>
                    <field name="print_gg_pct" invisible="not print_gg_bi"/>
                    <field name="print_bi_pct" invisible="not print_gg_bi"/>
                    <field name="print_amount_words"/>
                </group>
                <group string="Presentación">
                    <field name="print_cover"/>
                    <field name="print_signature"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
