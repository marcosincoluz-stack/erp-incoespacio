<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_ocr_obra_partida" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ocr.obra.partida</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="incoespacio_construction_certification.view_order_form_inherit_certification"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='name']" position="after">
                <field name="amount_vendor_cost" optional="show" widget="monetary"/>
            </xpath>
        </field>
    </record>
</odoo>
