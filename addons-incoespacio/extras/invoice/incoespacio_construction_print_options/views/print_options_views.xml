<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_print_custom" model="ir.actions.server">
        <field name="name">PDF personalizado</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_custom()</field>
    </record>

    <record id="view_sale_order_print_custom" model="ir.ui.view">
        <field name="name">sale.order.print.custom</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="PDF personalizado">
                <group name="group_chapters" string="Capítulos">
                    <field name="print_chapter_first_id" domain="[('order_id', '=', id), ('display_type', '=', 'line_section'), ('bc3_level', '=', 0)]" options="{'no_create': True}"/>
                    <field name="print_chapter_last_id" domain="[('order_id', '=', id), ('display_type', '=', 'line_section'), ('bc3_level', '=', 0)]" options="{'no_create': True}"/>
                    <field name="print_hide_null_chapters"/>
                </group>
                <group name="group_partidas" string="Partidas">
                    <field name="print_hide_null_price"/>
                    <field name="print_hide_null_qty"/>
                </group>
                <footer>
                    <button name="action_print_custom_pdf" type="object" string="Imprimir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_certification_print_custom" model="ir.actions.server">
        <field name="name">PDF personalizado</field>
        <field name="model_id" ref="incoespacio_construction_certification.model_construction_certification"/>
        <field name="binding_model_id" ref="incoespacio_construction_certification.model_construction_certification"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_custom()</field>
    </record>

    <record id="view_certification_print_custom" model="ir.ui.view">
        <field name="name">construction.certification.print.custom</field>
        <field name="model">construction.certification</field>
        <field name="arch" type="xml">
            <form string="PDF personalizado">
                <group string="Contenido">
                    <field name="print_full_text"/>
                    <field name="show_measure_sheet"/>
                </group>
                <group string="Capítulos">
                    <field name="print_chapter_first_id" domain="[('certification_id', '=', id), ('display_type', '=', 'line_section'), ('bc3_level', '=', 0)]" options="{'no_create': True}"/>
                    <field name="print_chapter_last_id" domain="[('certification_id', '=', id), ('display_type', '=', 'line_section'), ('bc3_level', '=', 0)]" options="{'no_create': True}"/>
                    <field name="print_hide_null_chapters"/>
                </group>
                <group string="Partidas">
                    <field name="print_hide_null_price"/>
                    <field name="print_hide_null_qty"/>
                </group>
                <footer>
                    <button name="action_print_custom_pdf" type="object" string="Imprimir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
