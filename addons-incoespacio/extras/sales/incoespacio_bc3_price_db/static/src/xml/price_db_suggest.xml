<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="incoespacio_bc3_price_db.PriceDbSuggest">
        <t t-if="isSection">
            <ListSectionAndNoteText t-props="sectionProps"/>
        </t>
        <t t-elif="props.readonly">
            <div class="o_price_db_full" t-esc="state.text"/>
        </t>
        <t t-else="">
            <textarea t-if="props.multiline" class="o_input o_price_db_full" t-ref="input"
                      placeholder="Título"
                      t-model="state.text" t-on-input="onInput" t-on-blur="onBlur"
                      t-on-keydown="onKeydown" autocomplete="off"/>
            <input t-else="" class="o_input" t-ref="input" type="text"
                   placeholder="Código"
                   t-model="state.text" t-on-input="onInput" t-on-blur="onBlur"
                   t-on-keydown="onKeydown" autocomplete="off"/>
            <ul t-if="state.open" class="dropdown-menu show o_price_db_menu" t-att-style="menuStyle">
                <li class="o_price_db_choices">
                    <ul class="list-unstyled mb-0">
                        <li t-foreach="state.choices" t-as="choice" t-key="choice.id">
                            <a href="#" class="dropdown-item o_price_db_choice"
                               t-on-mousedown.prevent="() => this.pick(choice)"
                               t-esc="choice.label"/>
                        </li>
                    </ul>
                </li>
                <li class="o_price_db_options">
                    <a href="#" class="dropdown-item o_m2o_dropdown_option"
                       t-on-mousedown.prevent="searchMore">Buscar más...</a>
                    <a t-if="term" href="#" class="dropdown-item o_m2o_dropdown_option"
                       t-on-mousedown.prevent="quickCreate">Crear "<t t-esc="term"/>"</a>
                    <a t-if="term" href="#" class="dropdown-item o_m2o_dropdown_option"
                       t-on-mousedown.prevent="createEdit">Crear y editar...</a>
                </li>
            </ul>
        </t>
    </t>
</templates>
