<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_price_db" model="ir.ui.view">
        <field name="name">sale.order.form.price.db</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="bc3_importer.view_sales_order_bc3"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='bc3_code']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                <attribute name="string">Partida</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                <attribute name="string">Partida</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="string">Partida</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom']" position="attributes">
                <attribute name="string">Unidad de obra</attribute>
            </xpath>
        </field>
    </record>
</odoo>
