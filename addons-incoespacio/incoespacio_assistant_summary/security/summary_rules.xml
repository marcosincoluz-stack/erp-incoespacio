<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="alert_rule_summary_read" model="ir.rule">
        <field name="name">Avisos: el resumen lee todos</field>
        <field name="model_id" ref="incoespacio_assistant.model_assistant_alert" />
        <field name="domain_force">[(1, '=', 1)] if user.assistant_summary else [('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
