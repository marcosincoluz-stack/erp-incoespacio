<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Prefijo de Presupuestos y Pedidos de Venta: 'P%(y)s' con padding 4 (ej: P260001, P260920) estándar Incoluz -->
        <record id="sale.seq_sale_order" model="ir.sequence">
            <field name="prefix">P%(y)s</field>
            <field name="padding">4</field>
        </record>

        <!-- Código del Diario de Facturas de Cliente a 'P26' (estándar Incoluz) -->
        <record id="account.1_sale" model="account.journal">
            <field name="code">P26</field>
        </record>
    </data>
</odoo>
