<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ai_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90" />
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="Digitalización OCR de Facturas con IA" id="ai_ocr_settings">
                    <setting
            id="gemini_api_key_setting"
            string="Google Gemini API Key"
            help="Se guarda cifrada y no se vuelve a mostrar. Para cambiarla, pega otra encima."
          >
                        <field name="gemini_api_key_status" readonly="1" />
                        <field
              name="gemini_api_key"
              password="True"
              placeholder="Pegar clave nueva (AIzaSy...)"
              autocomplete="new-password"
            />
                        <button
              name="action_clear_gemini_api_key"
              type="object"
              string="Borrar clave"
              class="btn-link"
              confirm="¿Borrar la clave de Gemini? El OCR dejará de funcionar hasta pegar otra."
            />
                    </setting>
                    <setting
            id="gemini_model_setting"
            string="Modelo Gemini"
            help="Modelo de visión utilizado para procesar los documentos PDF e imágenes."
          >
                        <field name="gemini_model" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
