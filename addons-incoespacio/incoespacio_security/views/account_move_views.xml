<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Restringir la confirmación/publicación de facturas a los validadores -->
        <record id="view_move_form_inherit_security" model="ir.ui.view">
            <field name="name">account.move.form.inherit.security</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_post'][1]" position="attributes">
                    <attribute name="groups">incoespacio_security.group_invoice_validator</attribute>
                </xpath>
                <xpath expr="//button[@name='action_post'][2]" position="attributes">
                    <attribute name="groups">incoespacio_security.group_invoice_validator</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
