[MASTER]
load-plugins=pylint_odoo
score=n

[ODOOLINT]
manifest-required-keys=license
manifest-deprecated-keys=active
license-allowed=AGPL-3,LGPL-3
valid-odoo-versions=17.0

[MESSAGES CONTROL]
disable=all

# Checks de Odoo utiles aqui. Fuera, a proposito:
# - manifest-required-author, missing-readme, development-status-allowed,
#   manifest-maintainers-list, website-manifest-key-not-valid-uri, invalid-commit:
#   convencion exclusiva de la OCA.
# - translation-required, xml-attribute-translatable: un solo idioma, ver CONTRIBUTING.
# - xml-deprecated-tree-attribute: los xpath heredan <tree>; renombrar a list los rompe.
enable=anomalous-backslash-in-string,
 assignment-from-none,
 attribute-deprecated,
 dangerous-default-value,
 dangerous-view-replace-wo-priority,
 duplicate-id-csv,
 duplicate-xml-fields,
 duplicate-xml-record-id,
 eval-referenced,
 eval-used,
 except-pass,
 external-request-timeout,
 license-allowed,
 manifest-deprecated-key,
 manifest-required-key,
 manifest-version-format,
 method-compute,
 method-inverse,
 method-search,
 missing-return,
 print-used,
 relative-import,
 sql-injection,
 translation-field,
 unreachable,
 xml-syntax-error,

[REPORTS]
msg-template={path}:{line}: [{msg_id}({symbol}), {obj}] {msg}
output-format=text
reports=no
