# ==============================================================================
# VARIABLES DE ENTORNO DE PRODUCCIÓN - INCOESPACIO ERP
# Copia este archivo como .env y ajusta los valores antes de desplegar
# ==============================================================================

# Dominio público del ERP
DOMAIN=erp.incoespacio.com

# Credenciales de Base de Datos PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_produccion_secreta

# Parámetros de Odoo
ODOO_ADMIN_PASSWORD=admin_secreta_aqui

# Configuración de Correo Saliente (Amazon SES o Microsoft 365)
SMTP_SERVER=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=TU_USUARIO_SES
SMTP_PASSWORD=TU_PASSWORD_SES
SMTP_SSL=STARTTLS
EMAIL_FROM=facturacion@incoespacio.com

# Configuración de Copias de Seguridad Amazon S3
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_DEFAULT_REGION=eu-south-2
S3_BUCKET_NAME=incoespacio-erp-backup
